{
  "manifest_version": 3,
  "name": "LiveDub",
  "version": "0.1.0",
  "description": "Real-time voice translation for videos — watch any video in your language",
  "author": "LiveDub",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.cognitive.microsofttranslator.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/index.js"],
      "css": ["src/content/ui/bubble.css"],
      "run_at": "document_end"
    }
  ],
  "options_page": "src/options/index.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
